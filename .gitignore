# Dependencies
node_modules/

# Build output
dist/
release/
seed-full/
*.tsbuildinfo

# Local runtime data — real campaign DBs, secrets, per-machine config.
# Never commit these; they contain the user's actual game data / auth keys.
server/data/
server/config/
server/data.sqlite
server/RPG-Vaultapp.db
*.db
*.db-shm
*.db-wal
*.sqlite

# Backups
_backups/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env files
.env
.env.*

# Claude Code local state (not project source)
.claude/
.mcp.json

# Сгенерированные артефакты инструментов, не исходники проекта
graphify-out/
.impeccable/

# Исходники графики (63 МБ PNG-оригиналов логотипов) — в сборку идут
# сжатые webp из client/src/assets/logos/, оригиналы храним вне репозитория.
res/

# Разовые скрипты под сторонний импорт (пути захардкожены под локальные
# папки, к проекту отношения не имеют) — лежат на диске, но не в репозитории.
server/scripts/

# Правила для Claude Code и рабочие материалы — на диске есть, в репозиторий
# не идут (рядом с уже игнорируемым .claude/).
CLAUDE.md
screenw/
docs/
# Дизайн-канвас: артборды .dc.html и собранный редактор (2.4 МБ минифицированного
# кода). Рабочий материал того же рода, что docs/ — макет живёт на диске и в
# опубликованном артефакте, в исходники проекта не идёт.
.design/

# Отдельное приложение-разрезатель PDF и его сборки (1 ГБ node_modules/dist)
# — своя история, в этом репозитории ему делать нечего.
pdf-splitter/

# Резервные копии полотна (125 МБ) — рядом с рабочими заметками ревизии,
# сами заметки (Canvas/*.md) в репозитории остаются.
Canvas/backup/

# Логи и дампы разработки: пишутся на ходу, к состоянию проекта отношения
# не имеют.
*.log
*.err
canvas_diff.txt
diff_screenshot.txt
.scratch/

# Разовые python-скрипты под импорт книг и разбор базы: пути захардкожены под
# локальные папки владельца, к проекту отношения не имеют — то же правило, что
# уже действует для server/scripts/.
*.py
scripts/*.py
scripts/kits_raw.json
