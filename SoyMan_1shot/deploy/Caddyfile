{$DOMAIN} {
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "no-cache"
    }
    respond /healthz "ok" 200
    file_server
}
