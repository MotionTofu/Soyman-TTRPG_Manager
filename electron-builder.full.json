{
  "appId": "com.rpgmanager.app.full",
  "productName": "SoyMan_ttrpg (с системами)",
  "asar": false,
  "directories": {
    "output": "release/full"
  },
  "files": [
    "electron/**/*",
    "server/dist/**/*",
    "server/package.json",
    "client/dist/**/*",
    "build/icon.png"
  ],
  "extraResources": [
    {
      "from": "server/node_modules",
      "to": "app/server/node_modules"
    },
    {
      "from": "seed-full",
      "to": "seed"
    }
  ],
  "win": {
    "icon": "build/icon.png",
    "target": ["portable", "nsis"]
  },
  "portable": {
    "artifactName": "SoyMan_ttrpg-Full-${version}.exe"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "artifactName": "SoyMan_ttrpg-Full-Setup-${version}.exe"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "MotionTofu",
      "repo": "Soyman-TTRPG_Manager"
    }
  ]
}
